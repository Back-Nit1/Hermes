# ---- Local mode (default): single user on this machine, no account setup needed.
# Leave OPENAI_API_KEY empty to run in demo mode (fixture data, no network).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Local token required on /api routes. Generated at startup if empty. Never used in remote mode.
APP_TOKEN=
APP_PORT=8765
DATA_ROOT=data
LOG_LEVEL=INFO
# Days to keep activity events and finished job rows (expired caches are always dropped).
RETENTION_DAYS=90
# Seconds running jobs get to finish on shutdown before being checkpointed as interrupted.
SHUTDOWN_GRACE_SECONDS=10
# Capacity. Research workers (1-16) and the per-lane job queue (1-10000). 512 is load-tested; lowering it makes
# big batches fail with "saturated". The writer is always 1 worker.
HERMES_RESEARCH_WORKERS=2
HERMES_JOB_QUEUE_SIZE=512
HERMES_RESEARCH_FRESHNESS_HOURS=336
# Seconds between background Gmail reply syncs (10-86400).
HERMES_GMAIL_SYNC_INTERVAL_SECONDS=300
# Optional: directory the backup timer writes *.hbk files to (absolute). Lets /api/metrics report backup age.
# HERMES_BACKUP_DIR=/var/backups/hermes
# Gmail OAuth client secret + token live outside the repo.
GMAIL_CREDENTIALS=~/.config/outreach/credentials.json
GMAIL_TOKEN=~/.config/outreach/token.json
# Analytics: estimated cost needs both prices (USD per million tokens); unknown otherwise.
HERMES_PRICE_INPUT_PER_MTOK=
HERMES_PRICE_OUTPUT_PER_MTOK=
# Notifications: days after a recorded send before a follow-up is due; 1 enables desktop notifications.
HERMES_FOLLOWUP_DAYS=7
HERMES_DESKTOP_NOTIFICATIONS=

# ---- Remote mode (optional): see docs/remote-deployment.md. Requires HTTPS.
# HERMES_MODE=remote
# HERMES_PUBLIC_URL=https://hermes.example.org
# HERMES_SECRET_KEY=            # python -m app.ops gen-secret-key; keep it OUT of DATA_ROOT and backups
# HERMES_TRUSTED_PROXIES=127.0.0.1
# APP_HOST=127.0.0.1            # bind behind the reverse proxy
